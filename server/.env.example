# Copia questo file in .env e compila i valori.

# Token che l'app usa per collegarsi al motore (minimo 16 caratteri).
# Generane uno con: openssl rand -hex 32
ATLANTE_TOKEN=

# Utente e gruppo con cui gira il container (id -u / id -g sul server).
PUID=1000
PGID=1000

# La cartella da indicizzare (montata in sola lettura) e la cartella delle note (scrivibile).
STORAGE_PATH=/mnt/storage
VAULT_PATH=/mnt/storage/vault
